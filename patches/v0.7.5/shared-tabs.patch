diff --git a/src/store/sharedLayoutSync.ts b/src/store/sharedLayoutSync.ts
new file mode 100644
index 0000000..22a392a
--- /dev/null
+++ b/src/store/sharedLayoutSync.ts
@@ -0,0 +1,230 @@
+import { dispatchHydrateLayoutFromPersisted } from './crossTabSync'
+import { onPersistBroadcast } from './persistBroadcast'
+import { removeLayout } from './panesSlice'
+import { PERSIST_DEBOUNCE_MS } from './persistMiddleware'
+import { parsePersistedLayoutRaw } from './persistedState'
+import { LAYOUT_STORAGE_KEY } from './storage-keys'
+
+/**
+ * Shares one set of open tabs across every device connected to this server.
+ *
+ * The server holds the latest persisted layout with a revision number. Each
+ * local layout write is pushed with the revision it was merged from; if another
+ * device pushed first, the server answers with its newer layout instead, which
+ * is merged here (the same merge cross-tab sync uses) and pushed again. Which
+ * tab and pane is active stays per device: hydration keeps the local choice.
+ *
+ * Tab closes travel as tombstones, but those expire after an hour, so a device
+ * that slept longer would resurrect tabs closed elsewhere. To prevent that,
+ * each browser remembers the tab ids it last shared with the server: a local
+ * tab that was shared but is gone from the server's layout was closed on
+ * another device and is dropped, while a tab the server has never seen was
+ * opened here and is kept and pushed.
+ */
+
+const KNOWN_TAB_IDS_STORAGE_KEY = 'freshell.shared-layout.known-tab-ids.v1'
+const PUSH_CHECK_DELAY_MS = PERSIST_DEBOUNCE_MS + 250
+const PLACEHOLDER_TAB_MAX_AGE_MS = 60_000
+
+type StoreLike = {
+  dispatch: (action: any) => any
+  getState: () => any
+}
+
+type SharedLayoutWsClient = {
+  send: (msg: unknown) => void
+  onMessage: (handler: (msg: any) => void) => () => void
+}
+
+function canonicalJson(value: unknown): string {
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`
+  if (value && typeof value === 'object') {
+    const entries = Object.entries(value as Record<string, unknown>)
+      .filter(([, v]) => v !== undefined)
+      .sort(([a], [b]) => (a < b ? -1 : a > b ? 1 : 0))
+    return `{${entries.map(([k, v]) => `${JSON.stringify(k)}:${canonicalJson(v)}`).join(',')}}`
+  }
+  return JSON.stringify(value) ?? 'null'
+}
+
+// What devices share: the tabs and their pane trees. Timestamps, tombstones and
+// the active tab/pane are left out so per-device differences never trigger a push.
+function sharedFingerprint(raw: string): string | null {
+  try {
+    const parsed = JSON.parse(raw)
+    const tabs: Array<{ id?: unknown }> = parsed?.tabs?.tabs ?? []
+    const tabIds = new Set(tabs.map((tab) => tab?.id))
+    const forOpenTabs = (byTab: Record<string, unknown> | undefined) =>
+      Object.fromEntries(Object.entries(byTab ?? {}).filter(([tabId]) => tabIds.has(tabId)))
+    return canonicalJson({
+      tabs,
+      layouts: forOpenTabs(parsed?.panes?.layouts),
+      paneTitles: forOpenTabs(parsed?.panes?.paneTitles),
+      paneTitleSetByUser: forOpenTabs(parsed?.panes?.paneTitleSetByUser),
+    })
+  } catch {
+    return null
+  }
+}
+
+function tabIdsOf(raw: string | null): string[] {
+  if (!raw) return []
+  return (parsePersistedLayoutRaw(raw)?.tabs.tabs ?? []).map((tab) => tab.id)
+}
+
+function hasEverSynced(): boolean {
+  try {
+    return localStorage.getItem(KNOWN_TAB_IDS_STORAGE_KEY) !== null
+  } catch {
+    return true
+  }
+}
+
+// A browser that has never synced and holds only a fresh, unnamed tab has just
+// the placeholder the app opens for first-time users; it should not be shared.
+function isPlaceholderOnly(tabs: Array<{ createdAt?: number; titleSetByUser?: boolean }>): boolean {
+  if (tabs.length !== 1 || tabs[0].titleSetByUser) return false
+  return typeof tabs[0].createdAt === 'number' && Date.now() - tabs[0].createdAt < PLACEHOLDER_TAB_MAX_AGE_MS
+}
+
+function loadKnownTabIds(): Set<string> {
+  try {
+    const parsed = JSON.parse(localStorage.getItem(KNOWN_TAB_IDS_STORAGE_KEY) || '[]')
+    return new Set(Array.isArray(parsed) ? parsed.filter((id) => typeof id === 'string') : [])
+  } catch {
+    return new Set()
+  }
+}
+
+function saveKnownTabIds(ids: string[]): void {
+  try {
+    localStorage.setItem(KNOWN_TAB_IDS_STORAGE_KEY, JSON.stringify(ids))
+  } catch {
+    // ignore
+  }
+}
+
+function readLocalLayoutRaw(): string | null {
+  try {
+    return localStorage.getItem(LAYOUT_STORAGE_KEY)
+  } catch {
+    return null
+  }
+}
+
+export function startSharedLayoutSync(store: StoreLike, ws: SharedLayoutWsClient): () => void {
+  if (typeof window === 'undefined' || typeof localStorage === 'undefined') return () => {}
+
+  // Nothing is pushed until this connection has received the server's layout.
+  let synced = false
+  let revision = 0
+  let serverFingerprint: string | null = null
+  let inFlight: { fingerprint: string | null; tabIds: string[] } | null = null
+  let pushCheckTimer: number | undefined
+  let replacePlaceholderTabs = !hasEverSynced()
+
+  const maybePush = () => {
+    if (!synced || inFlight) return
+    const raw = readLocalLayoutRaw()
+    if (!raw) return
+    const fingerprint = sharedFingerprint(raw)
+    if (fingerprint === serverFingerprint) return
+    inFlight = { fingerprint, tabIds: tabIdsOf(raw) }
+    ws.send({ type: 'layout.shared.push', raw, baseRevision: revision })
+  }
+
+  const schedulePushCheck = () => {
+    if (pushCheckTimer) window.clearTimeout(pushCheckTimer)
+    pushCheckTimer = window.setTimeout(() => {
+      pushCheckTimer = undefined
+      maybePush()
+    }, PUSH_CHECK_DELAY_MS)
+  }
+
+  const applyServerLayout = (raw: string | null) => {
+    const serverTabIds = tabIdsOf(raw)
+    const known = loadKnownTabIds()
+    saveKnownTabIds(serverTabIds)
+    const dropPlaceholderTabs = replacePlaceholderTabs && serverTabIds.length > 0
+    replacePlaceholderTabs = false
+    if (!raw) return
+
+    const localTabs = (store.getState()?.tabs?.tabs ?? []) as Array<{ id: string; createdAt?: number; titleSetByUser?: boolean }>
+    const localTabIds = localTabs.map((tab) => tab.id)
+    if (dropPlaceholderTabs && isPlaceholderOnly(localTabs)) {
+      for (const id of localTabIds) known.add(id)
+    }
+
+    let rawToHydrate = raw
+    const serverTabIdSet = new Set(serverTabIds)
+    const closedElsewhere = localTabIds.filter((id) => known.has(id) && !serverTabIdSet.has(id))
+    if (closedElsewhere.length > 0) {
+      try {
+        const parsed = JSON.parse(raw)
+        const now = Date.now()
+        parsed.tombstones = [
+          ...(Array.isArray(parsed.tombstones) ? parsed.tombstones : []),
+          ...closedElsewhere.map((id) => ({ id, deletedAt: now })),
+        ]
+        rawToHydrate = JSON.stringify(parsed)
+      } catch {
+        // Unparseable layouts are ignored by hydration anyway.
+      }
+    }
+
+    const localLayoutPersistedAt = parsePersistedLayoutRaw(readLocalLayoutRaw() || '')?.persistedAt
+    dispatchHydrateLayoutFromPersisted(store, rawToHydrate, localLayoutPersistedAt, true)
+
+    // Hydration keeps pane trees whose tab is gone; drop them so they are not
+    // persisted and shared.
+    const state = store.getState()
+    const openTabIds = new Set(((state?.tabs?.tabs ?? []) as Array<{ id: string }>).map((tab) => tab.id))
+    for (const tabId of Object.keys(state?.panes?.layouts ?? {})) {
+      if (!openTabIds.has(tabId)) store.dispatch(removeLayout({ tabId }))
+    }
+  }
+
+  const unsubscribeMessage = ws.onMessage((msg) => {
+    if (msg?.type === 'ready') {
+      // A new connection: the server sends its layout right after this.
+      synced = false
+      inFlight = null
+      return
+    }
+
+    if (msg?.type === 'layout.shared.ack') {
+      if (typeof msg.revision !== 'number') return
+      revision = msg.revision
+      if (inFlight) {
+        serverFingerprint = inFlight.fingerprint
+        saveKnownTabIds(inFlight.tabIds)
+        inFlight = null
+      }
+      maybePush()
+      return
+    }
+
+    if (msg?.type === 'layout.shared.state') {
+      if (typeof msg.revision !== 'number') return
+      const raw = typeof msg.raw === 'string' ? msg.raw : null
+      revision = msg.revision
+      serverFingerprint = raw ? sharedFingerprint(raw) : null
+      if (msg.reply) inFlight = null
+      synced = true
+      applyServerLayout(raw)
+      // Local tabs the server lacks may not change state on hydration, so no
+      // persist write would push them; check once the merge has been persisted.
+      schedulePushCheck()
+    }
+  })
+
+  const unsubscribePersist = onPersistBroadcast((msg) => {
+    if (msg.key === LAYOUT_STORAGE_KEY) maybePush()
+  })
+
+  return () => {
+    unsubscribeMessage()
+    unsubscribePersist()
+    if (pushCheckTimer) window.clearTimeout(pushCheckTimer)
+  }
+}
