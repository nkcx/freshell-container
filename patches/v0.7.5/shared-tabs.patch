@@ -0,0 +1,81 @@
+import fs from 'fs'
+import fsp from 'fs/promises'
+import path from 'path'
+import { getFreshellConfigDir } from './freshell-home.js'
+import { logger } from './logger.js'
+
+const log = logger.child({ component: 'shared-layout-store' })
+
+const SAVE_DEBOUNCE_MS = 1000
+
+export type SharedLayoutState = {
+  raw: string | null
+  revision: number
+}
+
+export type SharedLayoutPushResult =
+  | { accepted: true; revision: number }
+  | { accepted: false; state: SharedLayoutState }
+
+/**
+ * One tab layout shared by every browser connected to this server.
+ *
+ * The layout is the client's persisted layout payload, kept opaque here. Writes
+ * use optimistic concurrency: a push names the revision it was merged from and
+ * is rejected if another client got there first, so the pusher merges the newer
+ * layout and retries instead of overwriting tabs it has not seen.
+ */
+export class SharedLayoutStore {
+  private state: SharedLayoutState = { raw: null, revision: 0 }
+  private saveTimer: NodeJS.Timeout | null = null
+
+  constructor(private readonly filePath: string) {}
+
+  static open(filePath = path.join(getFreshellConfigDir(), 'shared-layout.json')): SharedLayoutStore {
+    const store = new SharedLayoutStore(filePath)
+    try {
+      const parsed = JSON.parse(fs.readFileSync(filePath, 'utf8'))
+      if (typeof parsed?.raw === 'string' && Number.isInteger(parsed?.revision) && parsed.revision > 0) {
+        store.state = { raw: parsed.raw, revision: parsed.revision }
+      }
+    } catch (error: any) {
+      if (error?.code !== 'ENOENT') {
+        log.warn({ err: error, filePath }, 'Could not read shared layout; starting empty')
+      }
+    }
+    return store
+  }
+
+  get(): SharedLayoutState {
+    return this.state
+  }
+
+  push(raw: string, baseRevision: number): SharedLayoutPushResult {
+    if (baseRevision !== this.state.revision) {
+      return { accepted: false, state: this.state }
+    }
+    this.state = { raw, revision: this.state.revision + 1 }
+    this.scheduleSave()
+    return { accepted: true, revision: this.state.revision }
+  }
+
+  private scheduleSave(): void {
+    if (this.saveTimer) return
+    this.saveTimer = setTimeout(() => {
+      this.saveTimer = null
+      void this.save()
+    }, SAVE_DEBOUNCE_MS)
+    this.saveTimer.unref?.()
+  }
+
+  private async save(): Promise<void> {
+    const tmpPath = `${this.filePath}.tmp`
+    try {
+      await fsp.mkdir(path.dirname(this.filePath), { recursive: true })
+      await fsp.writeFile(tmpPath, JSON.stringify(this.state))
+      await fsp.rename(tmpPath, this.filePath)
+    } catch (error) {
+      log.warn({ err: error, filePath: this.filePath }, 'Could not save shared layout')
+    }
+  }
+}
